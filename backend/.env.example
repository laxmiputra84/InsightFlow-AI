# InsightFlow AI Backend Configuration Example
ENVIRONMENT=development
PROJECT_NAME="InsightFlow AI API"
VERSION="1.0.0"

# MySQL Database Configuration
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=insightflow_user
MYSQL_PASSWORD=your_secure_password_here
MYSQL_DATABASE=insightflow_db

# SQLAlchemy Connection URL (URL-encode password special characters if needed)
DATABASE_URL=mysql+pymysql://insightflow_user:your_secure_password_here@127.0.0.1:3306/insightflow_db

# CORS Configuration (allowed frontend origins)
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Google Gemini API (Get key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# API Security & Authentication (Milestone 9)
ENABLE_API_KEY_AUTH=false
API_AUTH_KEY=your_production_secret_api_key_here

# Denial-of-Service (DoS) and Rate Limiting Controls
RATE_LIMIT_PER_MINUTE=120
MAX_REQUEST_SIZE_BYTES=2097152
